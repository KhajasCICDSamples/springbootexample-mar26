pipeline {
    agent any
    tools {
        maven 'Maven-3.9.16' 
    }
    stages {
        stage('SCM') {
            steps {
                git url: 'https://github.com/spring-projects/spring-petclinic.git',
                branch:'main' 
            }
        }
       stage ('Build'){
           steps{
               sh 'mvn --version'
               sh 'mvn validate'
           }
       }
    }
}